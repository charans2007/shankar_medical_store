# Flask Application Secrets
SECRET_KEY=change_this_to_a_secure_random_key_in_production
FLASK_ENV=development
FLASK_DEBUG=1

# Database Configuration
DATABASE_URL=sqlite:///database/medical_shop.db

# Default Admin Credentials (Used for first-time database seed)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=AdminSecurePass123!

# Google Maps API (Optional embed key if using Maps Embed API)
GOOGLE_MAPS_API_KEY=

# Initial Shop Configuration Placeholders (Overrides default shop values)
SHOP_NAME=[SHOP_NAME]
SHOP_TAGLINE=Your Trusted Local Medical Store & Pharmacy
OWNER_NAME=[OWNER_NAME]
PHONE_NUMBER=+919876543210
WHATSAPP_NUMBER=919876543210
EMAIL=contact@example-medicalshop.com
FULL_ADDRESS=[SHOP_NUMBER_AND_STREET], [AREA], [CITY], [STATE] - [PINCODE]
AREA=[AREA]
CITY=[CITY]
STATE=[STATE]
PINCODE=[PINCODE]
GOOGLE_MAPS_URL=https://maps.google.com/?q=pharmacy
LATITUDE=12.9716
LONGITUDE=77.5946
OPENING_HOURS=Monday - Saturday: 8:00 AM - 10:00 PM | Sunday: 9:00 AM - 2:00 PM
WEEKLY_CLOSURE=None
SHOP_DESCRIPTION=Your trusted neighborhood medical store dispensing authentic medicines, healthcare essentials, wellness products, and personalized care.
